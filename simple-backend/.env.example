# Agora ConvoAI Configuration Template
# Copy this file to .env and fill in your values

# =====================================================
# BASE CONFIGURATION (Voice-Only Mode)
# =====================================================

# Agora credentials
APP_ID=
APP_CERTIFICATE=
AGENT_AUTH_HEADER=
AGENT_ENDPOINT=https://api.agora.io/api/conversational-ai-agent/v2/projects

# LLM settings
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_URL=https://api.openai.com/v1/chat/completions

# TTS settings - Choose ONE vendor and provide all three values
TTS_VENDOR=  # Required: rime, elevenlabs, openai, or cartesia
TTS_KEY=  # Required: API key for your chosen TTS vendor
TTS_VOICE_ID=  # Required: Voice/speaker ID for your chosen vendor

# TTS_VOICE_ID options by vendor:
# - Rime: astra, deedee, marsh
# - ElevenLabs: Get from https://elevenlabs.io/
# - OpenAI: alloy, echo, fable, onyx, nova, shimmer
# - Cartesia: Get from https://cartesia.ai/

# ASR settings
ASR_VENDOR=ares
ASR_LANGUAGE=en-US

# Agent behavior
VAD_SILENCE_DURATION_MS=300
ENABLE_AIVAD=true
IDLE_TIMEOUT=120
MAX_HISTORY=32

# Prompts
DEFAULT_GREETING=hi there
DEFAULT_PROMPT=You are a virtual companion. The user can both talk and type to you and you will be sent text. Say you can hear them if asked. They can also see you as a digital human. Keep responses to around 10 to 20 words or shorter. Be upbeat and try and keep conversation going by learning more about the user.
DEFAULT_FAILURE_MESSAGE=Sorry, something went wrong

# =====================================================
# AVATAR PROFILE (Optional - for react-video-client-avatar)
# =====================================================
# Use ?profile=avatar to access these settings
# This allows running avatar clients with completely different credentials

# AVATAR_APP_ID=                    # Different Agora app ID (e.g., beta instance)
# AVATAR_APP_CERTIFICATE=           # Certificate for avatar app
# AVATAR_AGENT_AUTH_HEADER=         # Auth header for avatar app
# AVATAR_TTS_VENDOR=                # Different TTS vendor (e.g., elevenlabs)
# AVATAR_TTS_KEY=                   # Different TTS API key
# AVATAR_TTS_VOICE_ID=              # Different voice ID
# AVATAR_AVATAR_VENDOR=             # heygen or anam
# AVATAR_AVATAR_API_KEY=            # Avatar provider API key
# AVATAR_AVATAR_ID=                 # Avatar identifier from provider
# AVATAR_DEFAULT_PROMPT=            # Different prompt for avatar
# AVATAR_DEFAULT_GREETING=          # Different greeting for avatar

# =====================================================
# VENDOR-SPECIFIC SETTINGS (Optional)
# =====================================================

# Rime TTS options
RIME_MODEL_ID=mistv2
RIME_LANG=eng
RIME_SAMPLING_RATE=16000
RIME_SPEED_ALPHA=1.0

# ElevenLabs TTS options
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STABILITY=0.5

# OpenAI TTS options
# OPENAI_TTS_MODEL=tts-1

# Cartesia TTS options
# CARTESIA_MODEL=sonic-3

# Deepgram ASR (if using instead of Ares)
# DEEPGRAM_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# HeyGen avatar options (if using AVATAR_AVATAR_VENDOR=heygen)
# HEYGEN_QUALITY=high
# HEYGEN_ACTIVITY_IDLE_TIMEOUT=120

# Anam endpoints (used automatically when AVATAR_AVATAR_VENDOR=anam)
ANAM_AGENT_ENDPOINT=https://api-test.agora.io/api/conversational-ai-agent/v2/projects
ANAM_BASE_URL=https://api.anam.ai/v1

# =====================================================
# DEBUG OPTIONS
# =====================================================
# ENABLE_CURL_DUMP=false
