# Agora ConvoAI Configuration Template
# Copy this file to .env and fill in your values

# Required Agora settings
APP_ID=
APP_CERTIFICATE=
AGENT_AUTH_HEADER=

# LLM settings
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_URL=https://api.openai.com/v1/chat/completions

# TTS settings - Choose one vendor and provide all three values
TTS_VENDOR=  # Required: rime, elevenlabs, openai, or cartesia
TTS_KEY=  # Required: API key for your chosen TTS vendor
TTS_VOICE_ID=  # Required: Voice/speaker ID for your chosen vendor

# TTS_VOICE_ID options by vendor:
# For Rime: astra, deedee, marsh, etc.
# For ElevenLabs: TX3LPaxmHKxFdv7VOQHJ, etc. (get from https://elevenlabs.io/)
# For OpenAI: alloy, echo, fable, onyx, nova, shimmer
# For Cartesia: 71a7ad14-091c-4e8e-a314-022ece01c121, etc. (get from https://cartesia.ai/)

# Rime-specific settings (if using Rime)
RIME_MODEL_ID=mistv2
RIME_LANG=eng
RIME_SAMPLING_RATE=16000
RIME_SPEED_ALPHA=1.0

# ElevenLabs-specific settings (if using ElevenLabs)
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STABILITY=0.5

# OpenAI-specific settings (if using OpenAI)
# OPENAI_TTS_MODEL=tts-1

# Cartesia-specific settings (if using Cartesia)
# CARTESIA_MODEL=sonic-3

# ASR settings - Ares (default, no key needed) or Deepgram
ASR_VENDOR=ares
ASR_LANGUAGE=en-US

# Deepgram ASR (if using Deepgram)
# DEEPGRAM_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# VAD and Agent settings
VAD_SILENCE_DURATION_MS=300
ENABLE_AIVAD=true
IDLE_TIMEOUT=120
MAX_HISTORY=32

# Debug settings (optional)
# ENABLE_CURL_DUMP=false

# Avatar settings (optional - for react-video-client-avatar)
# Choose ONE: HeyGen or Anam

# Option 1: HeyGen Avatar (recommended)
# AVATAR_ENABLED=true
# AVATAR_VENDOR=heygen
# HEYGEN_API_KEY=your_heygen_key
# HEYGEN_AVATAR_ID=Wayne_20240711
# HEYGEN_QUALITY=high

# Option 2: Anam Avatar (BETA) - Requires special credentials
# AVATAR_ENABLED=true
# AVATAR_VENDOR=anam
# ANAM_API_KEY=your_anam_key
# ANAM_AVATAR_ID=your_avatar_id
# ANAM_BASE_URL=https://api.anam.ai/v1
# ANAM_BETA_APP_ID=your_beta_app_id
# ANAM_BETA_CREDENTIALS=your_credentials
# ANAM_BETA_ENDPOINT=https://api-test.agora.io/api/conversational-ai-agent/v2/projects

# Default: Avatar disabled (voice-only mode)
AVATAR_ENABLED=false

# Prompts and messages
DEFAULT_GREETING=hi there
DEFAULT_PROMPT=You are a virtual companion. The user can both talk and type to you and you will be sent text. Say you can hear them if asked. They can also see you as a digital human. Keep responses to around 10 to 20 words or shorter. Be upbeat and try and keep conversation going by learning more about the user.
DEFAULT_FAILURE_MESSAGE=Sorry, something went wrong

# =====================================================
# PROFILE-SPECIFIC OVERRIDES
# =====================================================
# Use PROFILENAME_VAR_NAME format to override any config per profile
# Access via ?profile=profilename query parameter
#
# Example: Avatar profile with separate APP_ID and TTS settings
# AVATAR_APP_ID=your_beta_app_id
# AVATAR_APP_CERTIFICATE=
# AVATAR_AGENT_AUTH_HEADER=Basic your_beta_credentials
# AVATAR_TTS_VENDOR=elevenlabs
# AVATAR_TTS_KEY=sk_your_elevenlabs_key
# AVATAR_TTS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# AVATAR_ELEVENLABS_MODEL=eleven_flash_v2_5
# AVATAR_TTS_SAMPLE_RATE=24000
# AVATAR_ELEVENLABS_STABILITY=0.5
# AVATAR_DEFAULT_PROMPT=You are a helpful avatar assistant...
# AVATAR_DEFAULT_GREETING=Hi! I'm your avatar assistant.
# AVATAR_AVATAR_ENABLED=true
# AVATAR_AVATAR_VENDOR=anam
# AVATAR_ANAM_API_KEY=your_anam_key
# AVATAR_ANAM_AVATAR_ID=your_avatar_id
# AVATAR_ANAM_BASE_URL=https://api.anam.ai/v1
# AVATAR_ANAM_BETA_APP_ID=your_beta_app_id
# AVATAR_ANAM_BETA_CREDENTIALS=your_credentials
# AVATAR_ANAM_BETA_ENDPOINT=https://api-test.agora.io/api/conversational-ai-agent/v2/projects
#
# Example: Sales profile with custom voice and prompt
# SALES_TTS_VOICE_ID=different_voice_id
# SALES_DEFAULT_PROMPT=You are a sales assistant...
# SALES_DEFAULT_GREETING=Hi! Looking for something specific today?
